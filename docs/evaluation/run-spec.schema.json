{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tgx.local/evaluation/run-spec-v1.schema.json",
  "title": "TGX Evaluation RunSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "protocol_sha256",
    "run_id",
    "engine",
    "artifact_ref",
    "source_repository",
    "expected_source_commit",
    "expected_binary_sha256",
    "profile_id",
    "manifest_path",
    "manifest_sha256",
    "baseline_cohort_id",
    "sample_seed",
    "net_concurrency",
    "file_concurrency",
    "dc_pool_size",
    "duration_seconds",
    "warmup_seconds",
    "scratch_root",
    "session_source_dir",
    "runner_image",
    "docker_command",
    "api_base",
    "environment"
  ],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "protocol_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "engine": {"enum": ["tdl", "tgx"]},
    "artifact_ref": {"type": "string", "minLength": 1},
    "source_repository": {"type": "string", "minLength": 1},
    "expected_source_commit": {"type": "string", "minLength": 7},
    "expected_binary_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "profile_id": {"enum": ["P-S", "P-SM", "P-LMS", "P-L"]},
    "manifest_path": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "baseline_cohort_id": {"type": "string", "minLength": 1},
    "sample_seed": {"type": "integer", "minimum": 0},
    "net_concurrency": {"type": "integer", "minimum": 1, "maximum": 128},
    "file_concurrency": {"type": "integer", "minimum": 1, "maximum": 64},
    "dc_pool_size": {"type": "integer", "minimum": 1, "maximum": 128},
    "duration_seconds": {"type": "integer", "minimum": 30, "maximum": 7200},
    "warmup_seconds": {"type": "integer", "minimum": 0, "maximum": 300},
    "repetition": {"type": "integer", "minimum": 1},
    "account_session_id": {"type": "string"},
    "proxy_route_id": {"type": "string"},
    "scratch_root": {"type": "string", "minLength": 1},
    "session_source_dir": {"type": "string", "minLength": 1},
    "runner_image": {"type": "string", "minLength": 1},
    "docker_command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "network_container": {"type": ["string", "null"]},
    "api_base": {"type": "string", "minLength": 1},
    "namespace": {"type": "string", "minLength": 1},
    "environment": {"type": "object"},
    "output_dir": {"type": "string", "minLength": 1},
    "state_db": {"type": "string", "minLength": 1},
    "log_dir": {"type": "string", "minLength": 1},
    "drain_timeout_seconds": {"type": "integer", "minimum": 10, "maximum": 3600}
  }
}
