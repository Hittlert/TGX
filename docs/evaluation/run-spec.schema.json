{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tgx.local/evaluation/run-spec-v1.schema.json",
  "title": "TGX Evaluation RunSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "run_id",
    "engine",
    "artifact_ref",
    "profile_id",
    "manifest_path",
    "sample_seed",
    "net_concurrency",
    "file_concurrency",
    "dc_pool_size",
    "duration_seconds",
    "warmup_seconds",
    "output_dir",
    "buffer_dir",
    "state_db",
    "log_dir"
  ],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "engine": {"enum": ["tdl", "tgx"]},
    "artifact_ref": {"type": "string", "minLength": 1},
    "profile_id": {"enum": ["P-S", "P-SM", "P-LMS", "P-L"]},
    "manifest_path": {"type": "string", "minLength": 1},
    "sample_seed": {"type": "integer", "minimum": 0},
    "net_concurrency": {"type": "integer", "minimum": 1, "maximum": 128},
    "file_concurrency": {"type": "integer", "minimum": 1, "maximum": 64},
    "dc_pool_size": {"type": "integer", "minimum": 1, "maximum": 128},
    "duration_seconds": {"type": "integer", "minimum": 30, "maximum": 7200},
    "warmup_seconds": {"type": "integer", "minimum": 0, "maximum": 300},
    "repetition": {"type": "integer", "minimum": 1},
    "buffer_mode": {"enum": ["none", "memory", "ssd"]},
    "buffer_size_bytes": {"type": "integer", "minimum": 0},
    "account_session_id": {"type": "string"},
    "proxy_route_id": {"type": "string"},
    "output_dir": {"type": "string", "minLength": 1},
    "buffer_dir": {"type": "string", "minLength": 1},
    "state_db": {"type": "string", "minLength": 1},
    "log_dir": {"type": "string", "minLength": 1},
    "drain_timeout_seconds": {"type": "integer", "minimum": 10, "maximum": 3600}
  }
}
