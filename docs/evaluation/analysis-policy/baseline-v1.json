{
  "policy_version": "baseline-v1",
  "protocol_version": "1.0",
  "missing_required_measurement": "BLOCKED",
  "invalid_artifact_identity": "INVALID",
  "required_metrics": {
    "common": [
      "rolling_5s_bps",
      "active_files",
      "queued_jobs"
    ],
    "tdl": [],
    "tgx": [
      "active_rpc",
      "ssd_free_bytes",
      "ssd_reserved_bytes",
      "archive_backlog_files",
      "archive_backlog_bytes",
      "archive_active_workers"
    ]
  },
  "required_environment_fields": [
    "host_id",
    "account_session_id",
    "proxy_route_id",
    "network_interface",
    "target_storage_id",
    "ssd_storage_id",
    "filesystem_types",
    "clock_source"
  ],
  "correctness": {
    "required_completed_file_match_fraction": 1.0,
    "completion_exempt_size_buckets": [
      "large_low",
      "large_mid",
      "large_high"
    ],
    "allow_unexpected_final_files": false,
    "allow_unowned_residue": false,
    "require_task_result_for_every_manifest_case": true
  },
  "stability": {
    "allow_unexpected_process_restart": false,
    "maximum_unexplained_zero_throughput_seconds": 10,
    "maximum_zero_throughput_fraction": 0.05,
    "require_ssd_admission_recovery": true,
    "require_target_backlog_drain": true
  },
  "performance": {
    "large_minimum_active_mbps": 150,
    "small_absolute_mbps_when_control_at_least_mbps": {
      "control_minimum_mbps": 250,
      "required_tgx_mbps": 200
    },
    "minimum_tgx_to_paired_tdl_payload_ratio": 0.75,
    "minimum_tgx_to_network_control_ratio_when_control_below_threshold": 0.75
  },
  "diagnosability": {
    "require_complete_trace_for_all_errors": true,
    "required_error_fields": [
      "case_id",
      "attempt_id",
      "stage",
      "op",
      "error_code",
      "error_cause",
      "retryable"
    ]
  },
  "diagnostic_only_metrics": [
    "wire_rx_bytes",
    "process_rss",
    "connection_count",
    "connection_failures",
    "ssd_write_bytes",
    "ssd_read_bytes",
    "ssd_backlog_bytes",
    "ssd_writer_concurrency",
    "archive_write_bytes",
    "archive_read_bytes",
    "archive_backlog_bytes",
    "archive_writer_concurrency",
    "target_write_bytes",
    "target_read_bytes",
    "target_backlog_bytes",
    "throughput_cv",
    "gc_pause",
    "device_iops",
    "device_await",
    "device_util",
    "fsync_latency",
    "target_read_amplification",
    "target_write_amplification"
  ]
}
