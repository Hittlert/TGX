# Example Configuration for Telegram Downloader (SBE v4.1)
api_id: 123456
api_hash: "0123456789abcdef0123456789abcdef"

chat:
  - chat_id: -1001234567890
    title: "Example Channel"
    last_read_message_id: 0
    priority: 100

file_formats:
  audio:
    - all
  document:
    - all
  video:
    - all

file_path_prefix:
  - chat_title
  - media_datetime

media_types:
  - audio
  - document
  - photo
  - video
  - voice
  - video_note

proxy: {}
disable_ipv6: true
save_path: /app/downloads
download_backend: tdl
